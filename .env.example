# Variables de Entorno para el Cliente (Vite)
# Se usan en el navegador
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Variables de Entorno para el Servidor (Netlify Functions)
# Se usan solo en el backend, nunca exponer al cliente
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu-service-role-key-secreta

# Opcional: Restricción de CORS para la API Admin
# ALLOWED_ORIGIN=https://tu-dominio.netlify.app