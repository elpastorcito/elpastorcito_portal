# Supabase Configuration (Frontend - public keys only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Configuration (Backend - Netlify Functions only, NEVER expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# CORS: Optional - override the default allowed origin
# ALLOWED_ORIGIN=https://your-production-domain.netlify.app
